// Task 2: Data representation using a jagged array
public class Main {
    public static void main(String[] args) {
        int[] slotsPerFloor = {2, 3, 1};
        String[][] slots = new String[slotsPerFloor.length][];

        for (int i = 0; i < slotsPerFloor.length; i++) {
            slots[i] = new String[slotsPerFloor[i]];
        }

        slots[0][0] = "TN01AB1111";
        slots[1][2] = "TN02CD2222";

        for (int i = 0; i < slots.length; i++) {
            for (int j = 0; j < slots[i].length; j++) {
                if (slots[i][j] == null) {
                    System.out.println("Floor " + i + ", Slot " + j + ": Free");
                } else {
                    System.out.println("Floor " + i + ", Slot " + j + ": " + slots[i][j]);
                }
            }
        }

        int minutes = 90;
        double hours = Math.ceil(minutes / 60.0);
        double fee = hours * 20;
        System.out.println("Fee: Rs " + fee);
    }
}
